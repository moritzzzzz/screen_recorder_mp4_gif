<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by the Hardened Runtime when the app calls AVCaptureDevice
         for the microphone. Without this, the app is terminated by the
         system the moment the user enables the Microphone toggle. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
